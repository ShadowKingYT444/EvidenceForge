# Server-only model providers
PRIMARY_PROVIDER=groq
PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Optional Featherless alternative
FEATHERLESS_API_KEY=

REVIEW_PROVIDER=nvidia_nim
REVIEW_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=

# Scholarly metadata
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# Private process-local sessions. Runs do not survive a server restart.
RUN_TOKEN_SECRET=
RUN_CACHE_TTL_MINUTES=120

# fixture serves the recorded demo only. Set live and configure every provider
# above before the main investigation composer can create a run.
# fixture | live
EVIDENCE_MODE=fixture
